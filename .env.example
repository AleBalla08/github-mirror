# Caminho do repo espelho (GitHub). Vazio = a raiz do repo onde o script esta.
MIRROR_REPO_PATH=
# Branch do espelho. Vazio = branch atual.
MIRROR_BRANCH=
# Arquivo de log de atividade dentro do espelho.
MIRROR_LOG_FILE=activity.md
# Mensagem generica do commit espelho (nunca use a mensagem do trabalho aqui).
MIRROR_COMMIT_MESSAGE=chore: registro de atividade
MIRROR_REMOTE=origin
WORK_REMOTE=origin
